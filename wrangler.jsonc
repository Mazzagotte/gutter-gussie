{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static mockup of the Idaho Gutter Gussie Club site. No Worker code yet: Cloudflare serves public/ as-is.
  // The working membership application + club admin lives on the membership-backend branch for later.
  "name": "gutter-gussie",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "guttergussie.mazzagotte.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
